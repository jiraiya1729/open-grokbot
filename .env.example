POSTGRES_DB=grokbot
POSTGRES_USER=grokbot
POSTGRES_PASSWORD=grokbot
DATABASE_URL=postgresql+psycopg://grokbot:grokbot@postgres:5432/grokbot
AUTH_MODE=local
LOCAL_USER_NAME=Local User
LOCAL_USER_EMAIL=local@open-grokbot.test
LOCAL_WORKSPACE_NAME=My Workspace
MODEL_PROVIDER=bedrock

# Keep real credentials in the ignored .env file, never in this example.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

ENABLE_INLINE_WORKER=false
INNGEST_EVENT_URL=http://inngest:8288/e/dev_key
INNGEST_EVENT_KEY=dev_key
INNGEST_SIGNING_KEY=
APP_ENCRYPTION_KEY=replace-with-a-long-unique-local-secret
NEXT_PUBLIC_API_URL=http://localhost:8000
# Local file/computer runtime. The daemon's public port serves only signed,
# expiring noVNC viewer sessions; Docker control endpoints still require its bearer token.
DATA_ROOT=./data
COMPUTER_PROVIDER=docker
COMPUTER_DAEMON_URL=http://localhost:8010
COMPUTER_DAEMON_TOKEN=local-computer-daemon
COMPUTER_EGRESS_NETWORK=open-grokbot-egress
COMPUTER_VIEWER_SECRET=replace-this-for-nonlocal-use
COMPUTER_VIEWER_PUBLIC_URL=http://localhost:8010
COMPUTER_IMAGE=open-grokbot-sandbox:0.3
